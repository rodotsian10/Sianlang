{
  "name": "SianLang",
  "scopeName": "source.sianlang",
  "fileTypes": [
    "sian"
  ],
  "patterns": [
    {
      "name": "support.function.sianlang",
      "match": "\\blog\\.f\\b"
    },
    {
      "name": "variable.parameter.sianlang",
      "match": "#[A-Za-z_][A-Za-z0-9_]*"
    },
    {
      "name": "comment.line.sianlang",
      "match": "\\|\\|.*$"
    },
    {
      "name": "comment.block.sianlang",
      "begin": "\\^\\^",
      "end": "\\^\\^"
    },
    {
      "name": "string.quoted.double.sianlang",
      "begin": "\"",
      "end": "\"",
      "patterns": [
        {
          "name": "constant.character.escape.sianlang",
          "match": "\\\\[nrt\\\"\\\\]"
        }
      ]
    },
    {
      "name": "keyword.control.sianlang",
      "match": "\\b(if|else|try|catch|repeat|while|loop|for|in|return|break|continue|and|or|Fjson|Frodot|scene|replace|add|delete)\\b"
    },
    {
      "name": "storage.type.sianlang",
      "match": "\\b(int|float|str|bool|TF|var)\\b"
    },
    {
      "name": "keyword.other.function.sianlang",
      "match": "\\b(def|func|f|function)\\b"
    },
    {
      "name": "support.function.sianlang",
      "match": "\\b(log(?:\\.f)?|input|len|range|time(?:\\.now)?|abs|min|max|round|random(?:\\.(?:int|float|choice))?|open|game(?:\\.(?:start|close|delta_time))?|scene\\.change|key\\.down|rodot(?:\\.(?:create|load|save))?|draw\\.(?:rect|circle|line|text))\\b"
    },
    {
      "name": "support.function.method.sianlang",
      "match": "\\.(append|pop|keys|values|items|read|readline|write|close|split|join|trim|contains|replace)\\b"
    },
    {
      "name": "constant.language.sianlang",
      "match": "\\b(true|false|None)\\b"
    },
    {
      "name": "constant.numeric.sianlang",
      "match": "(?<![\\w.])(?:\\d+(?:\\.\\d*)?|\\.\\d+)(?:[eE][+-]?\\d+)?(?![\\w.])"
    },
    {
      "name": "keyword.operator.sianlang",
      "match": "(==|!=|>=|<=|[+*/%<>=!-])"
    },
    {
      "name": "variable.other.sianlang",
      "match": "\\b[a-zA-Z_][a-zA-Z0-9_]*\\b"
    }
  ]
}
